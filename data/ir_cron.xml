<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Finishes the FR e-invoicing onboarding of a tenant: runs the
             annuaire lookup on the company partner as soon as a SUPER PDP token
             exists, then enables the platform and the three sending crons. Also
             restores the safe "not onboarded" state when a started onboarding
             was abandoned. Idempotent; no-op when l10n_fr_einvoicing is absent. -->
        <record id="cron_einvoicing_autosetup" model="ir.cron">
            <field name="name">Smart Doc: complete FR e-invoicing onboarding</field>
            <field name="model_id" ref="model_smart_doc_einvoicing_autosetup" />
            <field name="state">code</field>
            <field name="code">model._cron_complete_onboarding()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
